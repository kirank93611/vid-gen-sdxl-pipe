# Copy to .env.local — server-side only (never NEXT_PUBLIC_* for secrets).

SDXL_INFERENCE_BASE=http://127.0.0.1:8001
SDXL_API_URL=http://127.0.0.1:8001/generate
SDXL_JOBS_URL=http://127.0.0.1:8001/jobs
SDXL_API_KEY=dev-local-key
# Upstream timeout (ms). GPU quality tiers: 600000+
SDXL_FETCH_TIMEOUT_MS=600000
