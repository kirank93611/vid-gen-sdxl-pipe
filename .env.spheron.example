# Copy to .env.spheron (gitignored). Update SPHERON_IP after each new Spheron spot instance.
#
# SPHERON_SSH_KEY = path to PRIVATE key file (id_ed25519), NOT the public key line from Spheron.
# Generate: ssh-keygen -t ed25519 -f C:\Users\YOU\.ssh\id_ed25519
# Register: paste id_ed25519.pub into Spheron dashboard SSH keys.

SPHERON_IP=<VM_PUBLIC_IP>
SPHERON_USER=ubuntu
SPHERON_DIR=/home/ubuntu/image-sd
SPHERON_SSH_KEY=C:\Users\YOU\.ssh\id_ed25519
